# Python byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
todoenv/
# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Environment and secrets
.env
.env.*
secrets.json
*.secret
config/*.local

# Installer logs
pip-log.txt

# Unit test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Type checkers
.mypy_cache/
.pyre/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and databases
*.log
*.sqlite3
*.db

# Build artifacts
*.egg
*.whl

# Misc
*.tmp
*.bak

# OneDrive temp (Windows)
~$*

# End of .gitignore
